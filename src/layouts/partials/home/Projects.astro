---
import SectionLabel from "@/components/SectionLabel.astro";
import { markdownify } from "@/lib/utils/textConverter";
import {
  FaArrowRight,
  FaBoxArchive,
  FaCodeBranch,
  FaStar,
} from "react-icons/fa6";

const { projects } = Astro.props;

interface Project {
  name: string;
  description: string;
  url: string;
  stars: number;
  language: string;
  archived?: boolean;
}

const languageColors: Record<string, string> = {
  JavaScript: "#f1e05a",
  TypeScript: "#3178c6",
  Python: "#3572a5",
  CSS: "#663399",
  HTML: "#e34c26",
  Go: "#00add8",
  Astro: "#ff5a03",
};

const [featuredFirst, featuredSecond, ...restProjects] = projects.items;
---

<section id="work" class="section scroll-mt-24 pt-4">
  <div class="container">
    <SectionLabel text={projects.subtitle} className="mb-4" />
    <h2
      class="reveal mb-4 font-secondary text-3xl font-bold tracking-tight text-text-dark md:text-4xl lg:text-5xl [&_em]:text-accent [&_em]:not-italic dark:text-darkmode-text-dark dark:[&_em]:text-darkmode-accent"
      set:html={markdownify(projects.title)}
      data-reveal
      style="--reveal-delay:.06s"
    />
    <p
      class="reveal mb-12 max-w-2xl text-base text-text leading-relaxed md:text-lg [&_a]:underline [&_a]:decoration-accent/60 [&_a]:underline-offset-4 [&_a]:text-text-dark [&_a]:transition-colors [&_a:hover]:decoration-accent [&_a:hover]:text-accent dark:[&_a]:decoration-darkmode-accent/60 dark:[&_a]:text-darkmode-text-dark dark:[&_a:hover]:decoration-darkmode-accent dark:[&_a:hover]:text-darkmode-accent dark:text-darkmode-text"
      set:html={markdownify(projects.content)}
      data-reveal
      style="--reveal-delay:.12s"
    />

    {/* Featured Top Projects (2-col asymmetric hero cards) */}
    <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        [featuredFirst, featuredSecond].filter(Boolean).map((project: Project, index: number) => (
          <div
            class="reveal"
            data-reveal
            style={`--reveal-delay:${index * 0.08}s`}
          >
            <a
              class="group flex h-full flex-col justify-between rounded-2xl border border-border/80 bg-light/50 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:bg-light hover:shadow-lg dark:border-darkmode-border/80 dark:bg-darkmode-light/40 dark:hover:border-darkmode-accent/50 dark:hover:bg-darkmode-light"
              href={project.url}
              target="_blank"
              rel="noopener"
              data-spotlight
            >
              <div>
                <div class="mb-6 flex items-center justify-between">
                  <span class="inline-flex items-center gap-2 rounded-lg border border-border/60 bg-body px-2.5 py-1 text-xs font-mono font-medium text-text-dark dark:border-darkmode-border/60 dark:bg-darkmode-body dark:text-darkmode-text">
                    <FaCodeBranch className="h-3.5 w-3.5 text-accent dark:text-darkmode-accent" />
                    Featured
                  </span>
                  <span class="flex items-center gap-2">
                    {project.archived && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-0.5 text-[0.62rem] tracking-wider text-text-light uppercase dark:border-darkmode-border dark:text-darkmode-text-light">
                        <FaBoxArchive className="h-2.5 w-2.5" />
                        Archived
                      </span>
                    )}
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-body/80 px-2.5 py-1 text-xs font-semibold text-text-dark dark:border-darkmode-border/80 dark:bg-darkmode-body/80 dark:text-darkmode-text">
                      <FaStar className="h-3 w-3 shrink-0 text-amber-500" />
                      {project.stars}
                    </span>
                  </span>
                </div>
                <h3 class="mb-3 text-xl font-bold text-text-dark transition-colors group-hover:text-accent sm:text-2xl dark:text-darkmode-text-dark dark:group-hover:text-darkmode-accent">
                  {project.name}
                </h3>
                <p class="mb-6 text-sm leading-relaxed text-text sm:text-base dark:text-darkmode-text">
                  {project.description}
                </p>
              </div>
              <div class="flex items-center justify-between border-t border-border/60 pt-4 dark:border-darkmode-border/60">
                <div class="flex items-center gap-2 font-mono text-xs tracking-wide text-text-light dark:text-darkmode-text-light">
                  <span
                    class="h-2.5 w-2.5 rounded-full"
                    style={`background-color:${languageColors[project.language] ?? "#8e8a81"}`}
                    aria-hidden="true"
                  />
                  {project.language}
                </div>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-accent dark:text-darkmode-accent">
                  View Repo
                  <FaArrowRight className="h-2.5 w-2.5 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </div>
        ))
      }
    </div>

    {/* Secondary Projects Grid */}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        restProjects.map((project: Project, index: number) => (
          <div
            class="reveal"
            data-reveal
            style={`--reveal-delay:${(index % 4) * 0.06}s`}
          >
            <a
              class="group flex h-full flex-col justify-between rounded-xl border border-border/80 bg-light/30 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-light/70 hover:shadow-sm dark:border-darkmode-border/80 dark:bg-darkmode-light/30 dark:hover:border-darkmode-accent/40 dark:hover:bg-darkmode-light/70"
              href={project.url}
              target="_blank"
              rel="noopener"
              data-spotlight
            >
              <div>
                <div class="mb-3 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-text-dark dark:text-darkmode-text">
                    <FaStar className="h-3 w-3 shrink-0 text-amber-500" />
                    {project.stars}
                  </span>
                  <div class="flex items-center gap-1.5 font-mono text-[0.7rem] text-text-light dark:text-darkmode-text-light">
                    <span
                      class="h-2 w-2 rounded-full"
                      style={`background-color:${languageColors[project.language] ?? "#8e8a81"}`}
                      aria-hidden="true"
                    />
                    {project.language}
                  </div>
                </div>
                <h3 class="mb-2 text-base font-bold text-text-dark transition-colors group-hover:text-accent dark:text-darkmode-text-dark dark:group-hover:text-darkmode-accent">
                  {project.name}
                </h3>
                <p class="mb-4 text-xs leading-relaxed text-text dark:text-darkmode-text">
                  {project.description}
                </p>
              </div>
            </a>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center" data-reveal>
      <a
        class="group inline-flex items-center gap-2 rounded-full border border-border bg-light/60 px-5 py-2.5 font-mono text-xs font-semibold tracking-wider text-text-dark uppercase transition-all hover:border-accent/40 hover:bg-light hover:text-accent dark:border-darkmode-border dark:bg-darkmode-light/60 dark:text-darkmode-text-dark dark:hover:border-darkmode-accent/40 dark:hover:text-darkmode-accent"
        href={projects.github}
        target="_blank"
        rel="noopener"
      >
        See all repositories on GitHub
        <FaArrowRight
          className="h-3 w-3 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
