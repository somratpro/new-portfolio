---
import { markdownify } from "@/lib/utils/textConverter";
import { FaArrowUpRightFromSquare } from "react-icons/fa6";

const { experience } = Astro.props;

interface Job {
  role: string;
  company: string;
  url: string;
  period: string;
  description: string;
  tags: string[];
}
---

<section id="experience" class="section scroll-mt-24 pt-4">
  <div class="container">
    <h2
      class="reveal mb-12 font-secondary text-3xl font-bold tracking-tight text-text-dark md:text-4xl lg:text-5xl [&_em]:text-accent [&_em]:not-italic dark:text-darkmode-text-dark dark:[&_em]:text-darkmode-accent"
      set:html={markdownify(experience.title)}
      data-reveal
      style="--reveal-delay:.06s"
    />

    <!-- Timeline Container with Mathematically Centered Line -->
    <div class="relative space-y-6 md:space-y-8">
      <!-- Continuous Vertical Timeline Spine (Centered at 12px) -->
      <div
        class="pointer-events-none absolute left-2.75 top-6 bottom-6 w-0.5 bg-border/80 dark:bg-darkmode-border/80"
        aria-hidden="true"
      />

      {experience.jobs.map((job: Job, index: number) => {
        const isCurrent = job.period.toLowerCase().includes("present");
        return (
          <div class="group relative">
            {/* Milestone Node (Centered at 12px: left 0, width 24px) */}
            <div
              class:list={[
                "absolute left-0 top-5 sm:top-6 z-10 flex h-6 w-6 items-center justify-center rounded-full border-2 bg-body transition-colors duration-200 dark:bg-darkmode-body",
                isCurrent
                  ? "border-accent shadow-[0_0_12px_rgba(37,99,235,0.3)] dark:border-darkmode-accent dark:shadow-[0_0_12px_rgba(56,189,248,0.35)]"
                  : "border-border/90 group-hover:border-accent dark:border-darkmode-border/90 dark:group-hover:border-darkmode-accent",
              ]}
              aria-hidden="true"
            >
              <span
                class:list={[
                  "h-2 w-2 rounded-full transition-transform duration-200 group-hover:scale-125",
                  isCurrent
                    ? "bg-accent dark:bg-darkmode-accent"
                    : "bg-text-light/60 group-hover:bg-accent dark:bg-darkmode-text-light/60 dark:group-hover:bg-darkmode-accent",
                ]}
              />
            </div>

            {/* Content Card with Spotlight */}
            <article
              class="reveal ml-10 sm:ml-12 rounded-2xl border border-border/80 bg-light/30 p-5 transition-all duration-300 hover:border-accent/40 hover:bg-light/80 hover:shadow-xs sm:p-7 dark:border-darkmode-border/80 dark:bg-darkmode-light/30 dark:hover:border-darkmode-accent/40 dark:hover:bg-darkmode-light/70"
              data-reveal
              data-spotlight
              style={`--reveal-delay:${index * 0.05}s`}
            >
              {/* Header Row: Role, Company & Period */}
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <div>
                  <h3 class="text-base font-bold text-text-dark transition-colors group-hover:text-accent sm:text-lg md:text-xl dark:text-darkmode-text-dark dark:group-hover:text-darkmode-accent">
                    {job.role}
                  </h3>
                  <div class="mt-1 flex flex-wrap items-center gap-2">
                    <a
                      class="inline-flex items-center gap-1.5 text-sm font-semibold text-text-dark/80 transition-colors hover:text-accent dark:text-darkmode-text dark:hover:text-darkmode-accent"
                      href={job.url}
                      target="_blank"
                      rel="noopener"
                    >
                      {job.company}
                      <FaArrowUpRightFromSquare className="h-2.5 w-2.5 opacity-70" />
                    </a>
                  </div>
                </div>

                <span class="inline-flex items-center self-start rounded-full border border-border/80 bg-body/80 px-3 py-1 font-mono text-xs font-semibold text-text-light sm:self-auto dark:border-darkmode-border/80 dark:bg-darkmode-body/80 dark:text-darkmode-text-light">
                  {job.period}
                </span>
              </div>

              {/* Description */}
              <p class="mt-3.5 text-sm leading-relaxed text-text sm:text-base dark:text-darkmode-text">
                {job.description}
              </p>

              {/* Tags */}
              <div class="mt-4 flex flex-wrap items-center gap-1.5">
                {job.tags.map((tag: string) => (
                  <span class="rounded-md border border-border/70 bg-body/70 px-2.5 py-0.5 font-mono text-xs font-medium text-text-dark dark:border-darkmode-border/70 dark:bg-darkmode-body/70 dark:text-darkmode-text">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          </div>
        );
      })}
    </div>
  </div>
</section>
