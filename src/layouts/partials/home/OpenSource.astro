---
import { markdownify } from "@/lib/utils/textConverter";
import { FaGithub } from "react-icons/fa6";

const { opensource } = Astro.props;

interface Stat {
  value: number;
  suffix?: string;
  label: string;
}
---

<section id="opensource" class="section scroll-mt-24 pt-4">
  <div class="container">
    <div
      class="reveal rounded-3xl border border-border/80 bg-light/50 p-8 shadow-xs md:p-12 lg:p-14 dark:border-darkmode-border/80 dark:bg-darkmode-light/40"
      data-reveal
    >
      <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2
            class="mb-4 font-secondary text-3xl font-bold tracking-tight text-text-dark md:text-4xl lg:text-5xl [&_em]:text-accent [&_em]:not-italic dark:text-darkmode-text-dark dark:[&_em]:text-darkmode-accent"
            set:html={markdownify(opensource.title)}
          />
          <p
            class="mb-8 text-base leading-relaxed text-text dark:text-darkmode-text"
            set:html={markdownify(opensource.content)}
          />
          {
            opensource.button.enable && (
              <a
                class="btn btn-primary"
                href={opensource.button.link}
                target="_blank"
                rel="noopener"
              >
                <FaGithub className="mr-2 inline-block h-4 w-4" />
                {opensource.button.label}
              </a>
            )
          }
        </div>
        <div class="lg:col-span-7">
          <div class="grid grid-cols-2 gap-6 sm:gap-8">
            {
              opensource.stats.map((stat: Stat) => (
                <div class="rounded-2xl border border-border/60 bg-body/70 p-6 dark:border-darkmode-border/60 dark:bg-darkmode-body/60">
                  <span class="mb-1 block font-secondary text-3xl font-bold tracking-tight text-accent sm:text-4xl lg:text-5xl dark:text-darkmode-accent">
                    <span data-count={stat.value}>{stat.value}</span>
                    {stat.suffix}
                  </span>
                  <span class="block text-xs font-medium text-text-light sm:text-sm dark:text-darkmode-text-light">
                    {stat.label}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
