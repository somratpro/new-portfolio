---
import Social from "@/components/Social.astro";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
import { FaAws, FaCloud, FaGitAlt } from "react-icons/fa6";
import {
  SiAstro,
  SiBootstrap,
  SiGooglecalendar,
  SiHugo,
  SiJavascript,
  SiJekyll,
  SiMongodb,
  SiNextdotjs,
  SiNodedotjs,
  SiPostgresql,
  SiReact,
  SiSass,
  SiSupabase,
  SiTailwindcss,
  SiTypescript,
} from "react-icons/si";

const { hero } = Astro.props;
const match = hero.title.match(/\*([^*]+)\*/);
const highlightWord = match ? match[1] : "";
const [titleBefore, titleAfter] = highlightWord
  ? hero.title.split(`*${highlightWord}*`)
  : [hero.title, ""];
const scrambleWords =
  hero.words && hero.words.length ? hero.words : [highlightWord];

const techIcons: Record<string, { icon: any; color: string }> = {
  Sitepins: { icon: FaGitAlt, color: "text-[#38bdf8]" },
  Astro: { icon: SiAstro, color: "text-[#ff5d01]" },
  Hugo: { icon: SiHugo, color: "text-[#ff4088]" },
  React: { icon: SiReact, color: "text-[#61dafb]" },
  "Next.js": {
    icon: SiNextdotjs,
    color: "text-text-dark dark:text-darkmode-text-dark",
  },
  "Node.js": { icon: SiNodedotjs, color: "text-[#5fa04e]" },
  TailwindCSS: { icon: SiTailwindcss, color: "text-[#38bdf8]" },
  TypeScript: { icon: SiTypescript, color: "text-[#3178c6]" },
  JavaScript: { icon: SiJavascript, color: "text-[#f7df1e]" },
  SCSS: { icon: SiSass, color: "text-[#cf649a]" },
  Bootstrap: { icon: SiBootstrap, color: "text-[#7952b3]" },
  Jekyll: { icon: SiJekyll, color: "text-[#cc0000]" },
  MongoDB: { icon: SiMongodb, color: "text-[#47a248]" },
  PostgreSQL: { icon: SiPostgresql, color: "text-[#4169e1]" },
  Supabase: { icon: SiSupabase, color: "text-[#3ecf8e]" },
  AWS: { icon: FaAws, color: "text-[#ff9900]" },
  S3: { icon: FaCloud, color: "text-[#569a31]" },
};

const ghostSocials =
  "social-icons [&_li_a]:rounded-full [&_li_a]:border [&_li_a]:border-border [&_li_a]:bg-transparent [&_li_a]:text-text-dark [&_li_a]:transition [&_li_a:hover]:-translate-y-0.5 [&_li_a:hover]:border-accent [&_li_a:hover]:text-accent dark:[&_li_a]:border-darkmode-border dark:[&_li_a]:text-darkmode-text-dark dark:[&_li_a:hover]:border-darkmode-accent dark:[&_li_a:hover]:text-darkmode-accent";
---

<section class="hero relative overflow-hidden">
  <!-- Aceternity Developer Grid Background with Radial Vignette & Cursor Spotlight -->
  <div
    class="hero-dot-grid pointer-events-none absolute inset-0 -z-10"
    data-hero-grid
    aria-hidden="true"
  ></div>

  <!-- Ambient Orb Glow -->
  <div
    class="hero-orb pointer-events-none absolute -top-24 -right-16 h-140 w-140 rounded-full bg-radial from-accent/30 via-accent/5 to-transparent opacity-25 blur-3xl motion-safe:animate-orb-float dark:from-darkmode-accent/25 dark:via-darkmode-accent/5 dark:opacity-35 [&.is-tracked]:animate-none"
    aria-hidden="true"
  ></div>

  <div class="hero-inner container relative pt-12 pb-16 md:pt-20 md:pb-20">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/25 bg-emerald-500/5 px-4 py-1.5 text-xs font-semibold text-text-dark shadow-2xs transition-colors hover:border-emerald-500/40 hover:bg-emerald-500/10 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-darkmode-text">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>{hero.availability}</span>
      </div>
      <span
        class="hidden font-mono text-[0.72rem] tracking-[0.2em] text-text-light uppercase sm:inline-flex dark:text-darkmode-text-light"
        set:html={markdownify(hero.location)}
      />
    </div>

    <p class="mb-3 text-base font-semibold tracking-wide text-accent md:text-lg dark:text-darkmode-accent">
      {hero.greeting}
    </p>

    <!-- Hero Headline with Interactive Decryption Word -->
    <h1 class="font-secondary mb-6 max-w-5xl text-[clamp(2.5rem,6.8vw,5.2rem)] leading-[1.08] font-bold tracking-tight text-text-dark dark:text-darkmode-text-dark">
      <span>{titleBefore.trim()}</span>{" "}
      {highlightWord && (
        <span
          class="group/scramble relative inline-block cursor-pointer align-baseline select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 dark:focus-visible:ring-darkmode-accent/70 rounded-sm"
          data-scramble-word={highlightWord}
          data-words={JSON.stringify(scrambleWords)}
          title="Hover or tap to reveal next word"
          tabindex="0"
          role="button"
          aria-label="Hover, click, or press to reveal next word"
        >
          <span
            class="relative z-10 bg-linear-to-r from-accent via-sky-400 to-accent bg-size-[200%_auto] bg-clip-text font-bold text-transparent animate-shimmer dark:from-darkmode-accent dark:via-sky-200 dark:to-darkmode-accent"
            data-scramble-text
          >
            {highlightWord}
          </span>
          <span
            class="absolute -bottom-1 left-0 right-0 h-0.75 rounded-full bg-linear-to-r from-transparent via-accent to-transparent opacity-60 transition-all duration-300 group-hover/scramble:h-1 group-hover/scramble:opacity-100 dark:via-darkmode-accent"
            aria-hidden="true"
          />
        </span>
      )}{" "}
      <span>{titleAfter.trim()}</span>
    </h1>

    <p
      class="mb-8 max-w-2xl text-base leading-relaxed text-text md:text-lg dark:text-darkmode-text [&_a]:underline [&_a]:decoration-accent/60 [&_a]:underline-offset-4 [&_a]:text-text-dark [&_a]:transition-colors [&_a:hover]:decoration-accent [&_a:hover]:text-accent dark:[&_a]:decoration-darkmode-accent/60 dark:[&_a]:text-darkmode-text-dark dark:[&_a:hover]:decoration-darkmode-accent dark:[&_a:hover]:text-darkmode-accent"
      set:html={markdownify(hero.content)}
    />

    <div class="hero-cta flex flex-wrap items-center gap-4">
      {hero.buttons.map(
        (
          button: { enable: boolean; label: string; link: string },
          i: number,
        ) => {
          const isCalendar =
            button.link.includes("calendar.google.com") ||
            button.link.includes("calendar.app.google");
          return (
            button.enable && (
              <a
                class={`btn ${i === 0 ? "btn-primary" : "btn-outline-primary"}`}
                href={button.link}
                target={button.link.startsWith("http") ? "_blank" : "_self"}
                rel={
                  button.link.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                data-calendar-booking={isCalendar ? "30" : undefined}
              >
                {isCalendar && (
                  <SiGooglecalendar className="mr-2 inline-block h-4 w-4 shrink-0 text-accent dark:text-darkmode-accent" />
                )}
                {button.label}
              </a>
            )
          );
        },
      )}
      <Social source={social.main} className={ghostSocials} />
    </div>
  </div>

  <!-- Tech Marquee Banner (Upgraded Chip Stream) -->
  <div class="group relative overflow-hidden border-y border-border/70 bg-light/40 py-4 mask-[linear-gradient(to_right,transparent,black_6%,black_94%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)] dark:border-darkmode-border/70 dark:bg-darkmode-light/30">
    <div class="flex w-max animate-marquee items-center gap-3 group-hover:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:animate-none">
      {[0, 1, 2, 3].map((copy) => (
        <div
          class:list={[
            "flex items-center gap-3 shrink-0 pr-3",
            copy > 1 && "motion-reduce:hidden",
          ]}
          aria-hidden={copy > 0}
        >
          {hero.marquee.map((item: string) => {
            const tech = techIcons[item];
            const Icon = tech?.icon;
            return (
              <div class="group/chip inline-flex items-center gap-2 rounded-full border border-border/80 bg-body/90 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-text-dark shadow-2xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:shadow-xs dark:border-darkmode-border/80 dark:bg-darkmode-body/90 dark:text-darkmode-text-dark dark:hover:border-darkmode-accent">
                {Icon && (
                  <Icon
                    className={`h-3.5 w-3.5 shrink-0 transition-transform duration-300 group-hover/chip:scale-115 ${tech?.color}`}
                  />
                )}
                <span>{item}</span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>
