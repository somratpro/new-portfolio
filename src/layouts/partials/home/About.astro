---
import ImageMod from "@/components/ImageMod.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { markdownify } from "@/lib/utils/textConverter";

const { about } = Astro.props;
---

<section id="about" class="section scroll-mt-24">
  <div class="container">
    <div class="grid items-center gap-x-12 gap-y-12 md:grid-cols-12">
      <div class="reveal md:col-span-5 lg:col-span-5" data-reveal>
        <div
          class="group relative max-w-md overflow-hidden rounded-2xl border border-border/80 bg-light/60 p-2.5 shadow-sm transition-all duration-300 hover:border-accent/40 hover:shadow-md dark:border-darkmode-border/80 dark:bg-darkmode-light/60"
        >
          <ImageMod
            src={about.image}
            width={520}
            height={640}
            alt="Portrait of Somrat Sorkar"
            format="webp"
            class="w-full rounded-xl object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            fit="cover"
          />
        </div>
      </div>
      <div class="md:col-span-7 lg:col-span-7">
        <SectionLabel text={about.subtitle} className="mb-4" />
        <h2
          class="reveal mb-6 font-secondary text-3xl font-bold tracking-tight text-text-dark md:text-4xl lg:text-5xl [&_em]:text-accent [&_em]:not-italic dark:text-darkmode-text-dark dark:[&_em]:text-darkmode-accent"
          set:html={markdownify(about.title)}
          data-reveal
          style="--reveal-delay:.08s"
        />
        <div
          class="reveal mb-8 text-base leading-relaxed text-text md:text-lg [&_a]:underline [&_a]:decoration-accent/60 [&_a]:underline-offset-4 [&_a]:text-text-dark [&_a]:transition-colors [&_a:hover]:decoration-accent [&_a:hover]:text-accent [&_p]:mb-4 [&_p:last-child]:mb-0 dark:[&_a]:decoration-darkmode-accent/60 dark:[&_a]:text-darkmode-text-dark dark:[&_a:hover]:decoration-darkmode-accent dark:[&_a:hover]:text-darkmode-accent dark:text-darkmode-text"
          set:html={markdownify(about.content, true)}
          data-reveal
          style="--reveal-delay:.16s"
        />
        <dl
          class="reveal grid grid-cols-2 gap-4 border-t border-border pt-6 sm:grid-cols-2 dark:border-darkmode-border"
          data-reveal
          style="--reveal-delay:.24s"
        >
          {
            about.facts.map((fact: { label: string; value: string }) => (
              <div class="rounded-xl border border-border/60 bg-light/40 p-4 dark:border-darkmode-border/60 dark:bg-darkmode-light/40">
                <dt class="mb-1 font-mono text-[0.7rem] font-medium tracking-[0.16em] text-text-light uppercase dark:text-darkmode-text-light">
                  {fact.label}
                </dt>
                <dd class="text-sm font-semibold text-text-dark dark:text-darkmode-text-dark sm:text-base">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
