---
interface Props {
  text: string;
  className?: string;
  index?: string;
  invert?: boolean;
}

const { text, className = "" } = Astro.props;
---

<div
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-border/80 bg-light/70 px-3 py-1 text-xs font-medium text-text-dark dark:border-darkmode-border/80 dark:bg-darkmode-light/70 dark:text-darkmode-text",
    className,
  ]}
>
  <span
    class="h-1.5 w-1.5 rounded-full bg-accent dark:bg-darkmode-accent"
    aria-hidden="true"></span>
  <span>{text}</span>
</div>
